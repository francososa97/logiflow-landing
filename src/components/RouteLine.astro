---
// Elemento firma: la línea de ruta que conecta los estados de un envío,
// de depósito a entregado. Se dibuja sola al entrar en pantalla.
interface Props {
  stops: string[];
}
const { stops } = Astro.props;
const gapPct = 100 / (stops.length - 1);
---

<div class="route-line" role="img" aria-label={`Recorrido: ${stops.join(' → ')}`}>
  <div class="route-line__track-wrap">
    <svg viewBox="0 0 100 1" preserveAspectRatio="none" class="route-line__svg" aria-hidden="true">
      <line x1="0" y1="0.5" x2="100" y2="0.5" class="route-line__track"></line>
      <line x1="0" y1="0.5" x2="100" y2="0.5" class="route-line__draw"></line>
    </svg>
    {stops.map((_, i) => (
      <span
        class="route-line__dot"
        style={`left:${i * gapPct}%; animation-delay:${0.4 + i * 0.35}s`}
        aria-hidden="true"
      ></span>
    ))}
  </div>
  <div class="route-line__labels">
    {stops.map((stop) => (
      <span class="route-line__label">{stop}</span>
    ))}
  </div>
</div>

<style>
  .route-line {
    width: 100%;
  }

  .route-line__track-wrap {
    position: relative;
    height: 14px;
  }

  .route-line__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .route-line__track {
    stroke: var(--ink-line-strong);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .route-line__draw {
    stroke: var(--signal);
    stroke-width: 1.5;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    vector-effect: non-scaling-stroke;
    animation: draw-route 1.6s 0.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .route-line__dot {
    position: absolute;
    top: 50%;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--ink);
    border: 2px solid var(--signal);
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.3);
    animation: pop-dot 0.5s ease-out forwards;
  }

  .route-line__labels {
    display: flex;
    justify-content: space-between;
    margin-top: 0.85rem;
  }

  .route-line__label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.02em;
    color: var(--ink-muted);
    text-transform: uppercase;
  }

  .route-line__label:last-child {
    color: var(--signal-strong);
  }

  @keyframes draw-route {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes pop-dot {
    from {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.3);
    }
    to {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .route-line__draw {
      animation: none;
      stroke-dashoffset: 0;
    }
    .route-line__dot {
      animation: none;
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
  }
</style>
