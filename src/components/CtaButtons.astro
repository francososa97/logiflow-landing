---
import { whatsappHref, emailHref } from '../lib/cta';

interface Props {
  variant?: 'onink' | 'onpaper';
}
const { variant = 'onink' } = Astro.props;
---

<div class="flex flex-col gap-3 sm:flex-row">
  <a
    href={whatsappHref}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center justify-center gap-2 rounded-full bg-signal px-7 py-3.5 font-display text-[15px] font-semibold text-ink shadow-[0_10px_30px_rgba(15,184,140,0.35)] transition-transform duration-200 hover:-translate-y-0.5 hover:bg-signal-strong focus-visible:-translate-y-0.5"
  >
    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
      <path
        d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.77.46 3.45 1.35 4.95L2 22l5.29-1.39a9.9 9.9 0 0 0 4.75 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm5.8 14.16c-.24.68-1.4 1.3-1.93 1.35-.5.05-1.03.24-3.45-.72-2.91-1.16-4.77-4.12-4.92-4.31-.14-.19-1.18-1.57-1.18-3 0-1.42.75-2.12 1.01-2.41.26-.29.58-.36.77-.36.19 0 .39 0 .55.01.19.01.42-.07.66.5.24.58.83 2 .9 2.14.07.15.12.32.02.51-.1.19-.15.32-.29.49-.15.17-.31.38-.44.51-.15.15-.3.31-.13.6.17.29.76 1.25 1.63 2.03 1.12 1 2.06 1.31 2.35 1.46.29.15.46.12.63-.07.17-.19.72-.84.91-1.13.19-.29.38-.24.63-.14.26.1 1.64.77 1.92.91.29.14.48.22.55.34.07.12.07.7-.17 1.38Z"
      ></path>
    </svg>
    Agendar demo por WhatsApp
  </a>
  <a
    href={emailHref}
    class={`inline-flex items-center justify-center gap-2 rounded-full border px-7 py-3.5 font-display text-[15px] font-semibold transition-colors duration-200 ${
      variant === 'onink'
        ? 'border-ink-line-strong text-ink-text hover:border-signal hover:text-signal-strong'
        : 'border-paper-line text-paper-text hover:border-signal hover:text-signal'
    }`}
    style={variant === 'onink' ? 'border-color: var(--ink-line-strong);' : 'border-color: var(--paper-line);'}
  >
    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <rect x="3" y="5" width="18" height="14" rx="2"></rect>
      <path d="m3 7 9 6 9-6"></path>
    </svg>
    Escribir por email
  </a>
</div>
