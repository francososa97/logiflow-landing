---
const screens = [
  {
    n: '01',
    label: 'Dashboard',
    src: '/screens/dashboard.png',
    alt: 'Dashboard de LogiFlow con envíos, choferes y estado de entregas del día',
    caption: 'Control operativo del día: envíos, choferes y alertas en un solo lugar.',
  },
  {
    n: '02',
    label: 'Ruta optimizada',
    src: '/screens/ruta.png',
    alt: 'Detalle de una ruta optimizada por LogiFlow con mapa, distancia y duración',
    caption: 'Un click calcula el recorrido más corto y lo asigna al chofer al instante.',
  },
  {
    n: '03',
    label: 'Tracking público',
    src: '/screens/tracking.png',
    alt: 'Página pública de seguimiento de un envío de LogiFlow',
    caption: 'Tu cliente sigue su pedido con un link, sin login, como en ML o Andreani.',
  },
];
---

<section class="bg-paper py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <p class="font-mono text-xs uppercase tracking-[0.14em] text-signal">Así se ve, no una maqueta</p>
    <h2 class="mt-3 max-w-xl font-display text-3xl font-semibold tracking-tight text-paper-text sm:text-4xl">
      Capturas reales de LogiFlow en producción.
    </h2>

    <div class="mt-12 grid gap-6 sm:grid-cols-3">
      {screens.map((s) => (
        <figure class="screen-card">
          <span class="font-mono text-[11px] uppercase tracking-[0.1em] text-paper-muted">{s.n} — {s.label}</span>
          <div class="screen-frame mt-2">
            <img src={s.src} alt={s.alt} loading="lazy" width="640" height="400" />
          </div>
          <figcaption class="mt-3 text-sm leading-relaxed text-paper-muted">{s.caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .screen-card {
    display: flex;
    flex-direction: column;
  }

  .screen-frame {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 0.75rem;
    border: 1.5px solid var(--paper-line);
    background: var(--ink);
    box-shadow: var(--shadow-md);
  }

  .screen-frame img {
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    object-fit: cover;
    object-position: top;
  }
</style>
