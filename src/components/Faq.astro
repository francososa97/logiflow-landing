---
import { faqs } from '../lib/faq';
---

<section id="preguntas" class="bg-paper py-20 sm:py-28">
  <div class="mx-auto max-w-3xl px-5 sm:px-8">
    <h2 class="font-display text-3xl font-semibold tracking-tight text-paper-text sm:text-4xl">Preguntas frecuentes</h2>
    <div class="mt-10 grid gap-3">
      {faqs.map((f) => (
        <details class="faq rounded-2xl bg-white/60 px-5 py-4">
          <summary class="cursor-pointer list-none font-display text-base font-semibold text-paper-text">{f.q}</summary>
          <p class="mt-3 text-[15px] leading-relaxed text-paper-muted">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    border: 1.5px solid var(--paper-line);
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary::after {
    content: '+';
    float: right;
    color: var(--signal-deep);
    font-weight: 700;
  }
  .faq[open] summary::after {
    content: '−';
  }
</style>
