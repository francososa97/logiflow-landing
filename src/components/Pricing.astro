---
import { whatsappHref } from '../lib/cta';

const plans = [
  { name: 'Inicial', drivers: 'hasta 3 choferes', price: '49', featured: false },
  { name: 'PyME', drivers: 'hasta 10 choferes', price: '129', featured: true },
  { name: 'Flota', drivers: 'hasta 30 choferes', price: '299', featured: false },
];
---

<section id="precios" class="bg-paper py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="max-w-xl">
      <p class="font-mono text-xs uppercase tracking-[0.14em] text-paper-muted">Precios</p>
      <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-paper-text sm:text-4xl">
        Un plan por tamaño de flota, no por planilla.
      </h2>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-3">
      {plans.map((plan) => (
        <div class:list={['ticket relative rounded-2xl bg-white p-7', { 'ticket--featured': plan.featured }]}>
          {plan.featured && (
            <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-signal px-3.5 py-1 font-mono text-[11px] font-semibold uppercase tracking-wide text-ink">
              Más elegido
            </span>
          )}
          <span class="notch notch--left" aria-hidden="true"></span>
          <span class="notch notch--right" aria-hidden="true"></span>

          <h3 class="font-display text-xl font-semibold text-paper-text">{plan.name}</h3>
          <p class="mt-1 font-mono text-xs text-paper-muted">{plan.drivers}</p>

          <div class="ticket__stub mt-6 pt-6">
            <p class="flex items-baseline gap-1 font-display text-paper-text">
              <span class="text-sm text-paper-muted">USD</span>
              <span class="text-4xl font-semibold">{plan.price}</span>
              <span class="text-sm text-paper-muted">/mes</span>
            </p>
          </div>

          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              'mt-6 block rounded-full py-3 text-center font-display text-sm font-semibold transition-transform duration-200 hover:-translate-y-0.5',
              plan.featured ? 'bg-signal text-ink' : 'bg-paper-raised text-paper-text',
            ]}
          >
            Agendar demo
          </a>
        </div>
      ))}
    </div>

    <div class="mt-10 flex flex-col items-center gap-1 rounded-2xl border border-dashed px-6 py-6 text-center" style="border-color: var(--amber); background: var(--amber-soft);">
      <p class="font-display text-base font-semibold text-paper-text">Piloto de 30 días gratis, con onboarding incluido</p>
      <p class="text-sm text-paper-muted">A cambio de tu feedback. Sin compromiso.</p>
    </div>
  </div>
</section>

<style>
  .ticket {
    border: 1.5px solid var(--paper-line);
    display: flex;
    flex-direction: column;
  }

  .ticket--featured {
    border-color: var(--signal);
    box-shadow: var(--shadow-md);
    transform: translateY(-6px);
  }

  .ticket__stub {
    border-top: 1.5px dashed var(--paper-line);
  }

  .notch {
    position: absolute;
    top: 50%;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: var(--paper);
    transform: translateY(-50%);
  }

  .notch--left {
    left: -0.55rem;
  }

  .notch--right {
    right: -0.55rem;
  }
</style>
