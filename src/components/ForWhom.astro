---
const segments = [
  {
    tag: 'COU',
    title: 'Couriers y última milla',
    scale: '5–50 choferes',
    pain: 'Arman la ruta a mano cada mañana y no tienen visibilidad de dónde está cada chofer.',
  },
  {
    tag: 'DIS',
    title: 'Distribuidoras PyME',
    scale: '3–20 vehículos',
    pain: 'Alimentos, insumos, farma OTC: entregas fallidas sin registro y sin prueba de entrega.',
  },
  {
    tag: 'ECO',
    title: 'E-commerce y dark stores',
    scale: '2–15 choferes',
    pain: 'Envío propio con clientes preguntando "¿dónde está mi pedido?" todo el día por chat.',
  },
  {
    tag: 'MKT',
    title: 'Operadores de sellers',
    scale: '5–30 choferes',
    pain: 'Reparten para vendedores de Mercado Libre y Tiendanube y liquidan a mano, cliente por cliente.',
  },
];
---

<section class="bg-paper py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="max-w-xl">
      <p class="font-mono text-xs uppercase tracking-[0.14em] text-paper-muted">Para quién es</p>
      <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-paper-text sm:text-4xl">
        Si tu operación ya duele en Excel, es para vos.
      </h2>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2">
      {segments.map((s) => (
        <div class="segment-card relative rounded-2xl bg-white/60 p-6">
          <div class="flex items-center justify-between">
            <span class="font-mono text-[11px] font-semibold tracking-[0.1em] text-signal-deep">{s.tag}</span>
            <span class="rounded-full bg-paper-raised px-3 py-1 font-mono text-[11px] text-paper-muted">{s.scale}</span>
          </div>
          <h3 class="mt-4 font-display text-lg font-semibold text-paper-text">{s.title}</h3>
          <p class="mt-2 text-[15px] leading-relaxed text-paper-muted">{s.pain}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .segment-card {
    border: 1.5px dashed var(--paper-line);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .segment-card:hover {
    border-color: var(--signal);
    transform: translateY(-2px);
  }
</style>
